1. Write a C program to implement daytime client/server program using TCP sockets.
#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <time.h>
#include <pthread.h>
#include <arpa/inet.h>
#define PORT 5000
void *server(void *arg)
{
 int server, client;
 char msg[100];
 time_t now;
 struct sockaddr_in addr;
 addr.sin_family = AF_INET;
 addr.sin_port = htons(PORT);
 addr.sin_addr.s_addr = INADDR_ANY;
 server = socket(AF_INET, SOCK_STREAM, 0);
 bind(server, (struct sockaddr *)&addr, sizeof(addr));
 listen(server, 1);
 printf("Server: Daytime Server started...\n");
 client = accept(server, NULL, NULL);
 now = time(NULL);
 strcpy(msg, ctime(&now));
 send(client, msg, strlen(msg), 0);
 printf("Server: Sent time to client: %s", msg);
 close(client);
 close(server);
 return NULL;
}
int main()
{
 pthread_t thread;
 int client;
 char msg[100] = {0};
 struct sockaddr_in addr;
 addr.sin_family = AF_INET;
 addr.sin_port = htons(PORT);
 inet_pton(AF_INET, "127.0.0.1", &addr.sin_addr);
 pthread_create(&thread, NULL, server, NULL);
 sleep(1);
 client = socket(AF_INET, SOCK_STREAM, 0);
 connect(client, (struct sockaddr *)&addr, sizeof(addr));
 read(client, msg, sizeof(msg));
 printf("Client: Received time from server: %s", msg);
 close(client);
 pthread_join(thread, NULL);
 return 0;
}
